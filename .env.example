# ============================================================
# 复制本文件为 .env 并填入真实值：copy .env.example .env
# .env 已被 .gitignore 排除，不会被上传
# ============================================================

# ---- 必填：联网检索（https://tavily.com 免费注册）----
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ---- 必填：智谱 GLM（https://open.bigmodel.cn 控制台获取）----
# 所有模型节点使用 openai:glm-5.3-flashx，经智谱 OpenAI 兼容端点接入
ZHIPUAI_API_KEY=your_zhipu_api_key_here

# ---- 可选：LangSmith 追踪（不使用则保持 TRACING=false，KEY 可留空）----
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=deep_research_from_scratch

# ---- 可选：研究参数（未设置时使用代码默认值），修改后需重启后端 ----
# supervisor 的最大研究轮数（一轮 = 派题 -> 执行 -> 复盘），建议 >= 3，
# 设为 1 会导致 supervisor 不派研究员直接退出
MAX_RESEARCHER_ITERATIONS=3
# 单个 researcher 子代理最多执行的 tavily_search 次数（硬上限，达到后强制进入压缩）
MAX_RESEARCHER_SEARCHES=3
# supervisor 每轮最多并行启动的研究员数量
MAX_CONCURRENT_RESEARCHERS=3
# brief 人工审核的最大打回修订轮数（超过后仅提示警告，不强制中断）
MAX_BRIEF_REVIEW_ROUNDS=5
# 调试开关：true 时简报确认后直接结束，跳过 supervisor/研究阶段
BRIEF_ONLY_DEBUG_MODE=false
